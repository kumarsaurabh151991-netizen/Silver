# Copy to .env and fill in your key. The app boots without a key but the AI
# assistant will report itself as temporarily unavailable.
OPENAI_API_KEY=
 
# Optional overrides (defaults shown)
CMS_AI_ENABLED=true
CMS_AI_CHAT_MODEL=gpt-4o-mini
CMS_AI_CHAT_TEMPERATURE=0.2
CMS_AI_EMBEDDING_MODEL=text-embedding-3-small
CMS_AI_RAG_TOP_K=5
CMS_AI_RAG_SIMILARITY_THRESHOLD=0.3
CMS_AI_MEMORY_MAX_MESSAGES=20
CMS_AI_RAG_PERSIST=true
CMS_AI_RAG_STORE_DIR=./data/vector-store
CMS_DB_URL=sqlite:///./data/cmsdb.sqlite